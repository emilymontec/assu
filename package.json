{
  "name": "assu",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo de Assu — verificación automática de movimientos bancarios. Ver README.md.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:backend": "pnpm --filter assu-backend run start:dev",
    "dev:frontend": "pnpm --filter assu-frontend run dev",
    "dev:home": "pnpm --filter assu-home run dev",
    "dev:portal": "pnpm --filter assu-portal run dev",
    "build": "pnpm -r run build",
    "test": "pnpm --filter assu-backend run test",
    "lint": "pnpm -r run lint"
  }
}
