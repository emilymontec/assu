# URL del backend de Assu (repo assu-backend/; NO es pública, solo la usa el proxy server-side)
ASSU_BACKEND_API_URL=http://localhost:3000

# Debe coincidir con INTERNAL_API_KEY del backend (.env del proyecto assu-backend/).
# Nunca se expone al navegador: solo la lee app/api/backend/[...path]/route.ts
ASSU_BACKEND_API_KEY=change-me-in-production
