# NestJS depende de reflect-metadata y de que ciertos paquetes de tipos
# (ej. @types/*) queden accesibles como si fueran dependencias planas.
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true

# node-linker=hoisted: evita el modo "isolated" (symlinks + hardlinks) que
# pnpm usa por defecto. En Windows, ese modo es el causante más común del
# error ERR_PNPM_EBUSY (rename de archivos temporales bloqueado por
# OneDrive o el antivirus mientras pnpm crea los symlinks). "hoisted"
# genera un node_modules plano, igual que npm/yarn classic: más lento en
# instalaciones grandes, pero mucho más confiable en Windows.
node-linker=hoisted
