# ── App ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=collector

# ── Base de datos (PostgreSQL / Prisma) ───────────────────
DATABASE_URL="postgresql://assu:assu@localhost:5432/assu?schema=public"

# ── Redis (BullMQ + Session Manager + Rate Limiting) ───────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Seguridad / Cifrado de credenciales (AES-256-GCM) ─────
# Generar con: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# Opcional: solo durante una rotación de clave. Pon aquí la clave ANTERIOR
# para que el sistema siga pudiendo descifrar credenciales ya guardadas
# mientras migran a la nueva CREDENTIALS_ENCRYPTION_KEY. Quítala cuando
# termine la migración.
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=

# ── API interna (autenticación entre microservicios) ──────
INTERNAL_API_KEY=change-me-in-production

# ── Scheduler ───────────────────────────────────────────
DEFAULT_SYNC_INTERVAL_SECONDS=60

# ── Rate Limiting ───────────────────────────────────────
# Máximo de solicitudes por minuto hacia un mismo banco (todas sus cuentas
# suman al mismo contador) — evita que un pico de cuentas sincronizando a
# la vez parezca un abuso al portal del banco.
RATE_LIMIT_MAX_PER_BANK_PER_MINUTE=20
# Mínimo de segundos entre dos syncs de la MISMA cuenta, sin importar si
# vienen del Scheduler o de un POST /sync manual repetido.
RATE_LIMIT_MIN_SECONDS_BETWEEN_ACCOUNT_SYNCS=10

# ── Playwright / Scraping ─────────────────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=info

# ── Eventos (Redis Streams) ───────────────────────────────
EVENTS_STREAM_NAME=assu.movements

# ── Monitoring & Alerts ────────────────────────────────────
# Minutos sin sincronizar (mínimo) antes de alertar una cuenta como "sin
# sincronizar". Si syncIntervalSeconds*3 de la cuenta da más que esto, se
# usa ese valor en su lugar.
MONITORING_STALE_THRESHOLD_MINUTES=30
# Ventana y umbral para "tasa de errores elevada" a nivel de sistema.
MONITORING_ERROR_RATE_WINDOW_MINUTES=15
MONITORING_ERROR_RATE_THRESHOLD=0.5
MONITORING_ERROR_RATE_MIN_SAMPLE=3
# No repetir la misma alerta (mismo tipo + misma entidad) antes de esto.
MONITORING_ALERT_COOLDOWN_MINUTES=60

# ── Verificación de comprobantes (Payment Verification) ────
# Todas opcionales para arrancar: sin ellas, Collector sigue funcionando
# (detección de movimientos), pero la ingesta por WhatsApp y el envío de
# respuestas quedan deshabilitados hasta configurarlas.
RECEIPTS_STORAGE_PATH=./storage/receipts

# 'tesseract' activa OCR real (Tesseract.js, local, gratis, sin
# credenciales de nube). Cualquier otro valor deja el placeholder que
# siempre manda todo a MANUAL_REVIEW. La primera vez que se usa,
# Tesseract descarga ~15MB del modelo de idioma español desde internet.
OCR_PROVIDER=null

# Ingesta de comprobantes por WhatsApp vía open-wa (WhatsApp Web
# automatizado — pensado para este demo, no requiere cuenta de Meta ni
# WhatsApp Business API). La primera vez que arrancas el backend con
# OPENWA_HEADLESS=false vas a tener que escanear un QR con el WhatsApp
# de la cuenta que quieras usar; la sesión queda guardada en disco
# (`<OPENWA_SESSION_ID>.data.json`) para no repetirlo en cada arranque.
OPENWA_SESSION_ID=assu-backend
OPENWA_HEADLESS=true
# open-wa controla un solo número de WhatsApp por sesión, así que (a
# diferencia de Cloud API) no hay una URL de webhook por cuenta: todo
# comprobante que llegue a esta sesión se asocia a esta cuenta bancaria.
OPENWA_BANK_ACCOUNT_ID=
