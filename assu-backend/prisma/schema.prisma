generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BankStatus {
  ACTIVE
  INACTIVE
  DEGRADED
}

enum IntegrationType {
  WEB_SCRAPING
  MOBILE_PROXY
  FILE_EXPORT
  HYBRID
}

model Bank {
  id            String        @id @default(uuid())
  name          String
  country       String
  status        BankStatus    @default(ACTIVE)
  integrationType IntegrationType @map("integration_type")
  adapterKey    String        @unique @map("adapter_key")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  accounts BankAccount[]

  @@map("banks")
}

enum AccountStatus {
  PENDING
  ACTIVE
  REAUTH_REQUIRED
  SUSPENDED
  ERROR
}

model BankAccount {
  id                    String        @id @default(uuid())
  bankId                String        @map("bank_id")
  merchantId            String        @map("merchant_id")
  accountNumber         String        @map("account_number")
  encryptedCredentials  String        @map("encrypted_credentials") @db.Text
  // Autoatestación de quien registró la cuenta: "esta credencial es de
  // solo consulta, sin permisos de transferencia/retiro". El sistema NO
  // puede verificar esto contra el banco (eso lo decide el banco al
  // crear el usuario/rol) — es una responsabilidad del operador, no una
  // garantía criptográfica. La garantía real, estructural, es que
  // `BankAdapter` (ver core/ports/bank-adapter.interface.ts)
  // solo expone login()/sync()/logout() — no existe ningún método de
  // transferencia en ningún adapter, así que aunque la credencial SÍ
  // tuviera permisos de escritura, el código no tiene cómo usarlos.
  credentialsReadOnlyConfirmed Boolean @default(false) @map("credentials_read_only_confirmed")
  status                AccountStatus @default(PENDING)
  syncEnabled           Boolean       @default(true) @map("sync_enabled")
  syncIntervalSeconds   Int           @default(60) @map("sync_interval_seconds")
  lastSyncAt            DateTime?     @map("last_sync_at")
  lastMovementReference String?       @map("last_movement_reference")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  bank               Bank                @relation(fields: [bankId], references: [id])
  // FK real a Merchant: en un sistema multi-tenant, una cuenta con un
  // `merchant_id` que no corresponde a ningún comercio es un dato
  // huérfano que rompe silenciosamente el aislamiento (nadie podría ver
  // ni reclamar esa cuenta). La constraint obliga a que todo dueño de
  // cuenta exista como comercio registrado.
  merchant           Merchant            @relation(fields: [merchantId], references: [id])
  movements          Movement[]
  syncLogs           SyncLog[]
  paymentSubmissions PaymentSubmission[]

  @@index([merchantId])
  @@index([bankId])
  @@map("bank_accounts")
}

enum MovementType {
  DEPOSIT
  TRANSFER
  WITHDRAWAL
  REVERSAL
  PAYMENT
  UNKNOWN
}

enum MovementStatus {
  RECEIVED
  VALID
  INVALID
  DUPLICATE
}

model Movement {
  id           String         @id @default(uuid())
  accountId    String         @map("account_id")
  reference    String
  amount       Decimal        @db.Decimal(18, 2)
  currency     String         @default("COP")
  sender       String?
  receiver     String?
  movementType MovementType   @map("movement_type")
  date         DateTime
  status       MovementStatus @default(RECEIVED)
  verified     Boolean        @default(false)
  rawData      Json           @map("raw_data")
  createdAt    DateTime       @default(now()) @map("created_at")

  account BankAccount @relation(fields: [accountId], references: [id])

  // Un movimiento solo puede quedar VERIFIED en, como máximo, un
  // PaymentSubmission. La constraint es la barrera real contra "reusar"
  // un mismo movimiento para validar dos comprobantes: aunque el código
  // de aplicación tenga un bug de concurrencia, Postgres no deja
  // insertar/actualizar un segundo submission con el mismo
  // matched_movement_id (múltiples NULL sí están permitidos).
  paymentSubmission PaymentSubmission?

  @@unique([accountId, reference, amount, date], name: "uniq_account_reference_amount_date")
  @@index([accountId, date])
  @@map("bank_movements")
}

// ─────────────────────────────────────────────────────────────────────
// Verificación de comprobantes (Payment Verification)
//
// Representa el flujo: comprobante recibido (Telegram/API) → OCR →
// conciliación contra `Movement` → estado final. Vive en tablas propias,
// separadas de `Movement`, para no acoplar la detección bancaria (que
// no sabe nada de comprobantes) con la verificación de pagos (que no
// sabe nada de scraping).
// ─────────────────────────────────────────────────────────────────────

enum SubmissionChannel {
  TELEGRAM
  API
}

// Máquina de estados. Las transiciones válidas viven en código
// (payment-verification.service.ts / ALLOWED_TRANSITIONS), no aquí:
// Postgres no impide guardar cualquier valor del enum, por eso el
// guardado de cada cambio de estado pasa siempre por
// PaymentVerificationService.transition(), que sí las valida y dejan
// registro en VerificationEvent.
enum PaymentSubmissionStatus {
  RECEIVED
  PROCESSING
  PENDING_MOVEMENT
  MATCHING
  VERIFIED
  AMBIGUOUS
  REJECTED
  ERROR
  MANUAL_REVIEW
}

enum MatchResult {
  EXACT_MATCH
  PROBABLE_MATCH
  AMBIGUOUS_MATCH
  NO_MATCH
  PENDING
}

enum OcrConfidence {
  HIGH
  MEDIUM
  LOW
}

model PaymentSubmission {
  id      String            @id @default(uuid())
  channel SubmissionChannel

  // Id del mensaje/evento en el canal de origen (ej. Telegram message id).
  // Junto con `channel` da idempotencia real ante reintentos/reentregas
  // del webhook: un mismo mensaje jamás crea dos submissions.
  externalMessageId String? @map("external_message_id")

  senderIdentifier String  @map("sender_identifier") // teléfono/usuario, ya enmascarado antes de persistir
  bankAccountId    String? @map("bank_account_id") // cuenta contra la que se intentará conciliar; puede resolverse después

  fileHash       String @map("file_hash") @db.VarChar(64) // sha256 del archivo recibido, para detectar reutilización
  fileStorageRef String @map("file_storage_ref") // referencia opaca (no la ruta cruda) al almacenamiento del archivo
  fileMimeType   String @map("file_mime_type")

  status PaymentSubmissionStatus @default(RECEIVED)

  ocrExtractedData Json?          @map("ocr_extracted_data")
  ocrConfidence    OcrConfidence? @map("ocr_confidence")

  matchedMovementId String?      @unique @map("matched_movement_id")
  matchResult       MatchResult? @map("match_result")
  matchScore        Float?       @map("match_score")

  rejectionReason String? @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bankAccount     BankAccount?        @relation(fields: [bankAccountId], references: [id])
  matchedMovement Movement?           @relation(fields: [matchedMovementId], references: [id])
  events          VerificationEvent[]

  // Idempotencia ante reentregas del canal (Telegram/otros reintentan
  // si no reciben 200 a tiempo).
  @@unique([channel, externalMessageId], name: "uniq_channel_external_message")
  @@index([fileHash])
  @@index([status])
  @@index([bankAccountId])
  @@map("payment_submissions")
}

model VerificationEvent {
  id           String                   @id @default(uuid())
  submissionId String                   @map("submission_id")
  fromStatus   PaymentSubmissionStatus? @map("from_status")
  toStatus     PaymentSubmissionStatus  @map("to_status")
  reason       String?                  @db.Text
  actor        String // "SYSTEM" | "USER:<id>" — quién disparó la transición
  createdAt    DateTime                 @default(now()) @map("created_at")

  submission PaymentSubmission @relation(fields: [submissionId], references: [id])

  @@index([submissionId])
  @@map("verification_events")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum AuditAction {
  LOGIN
  LOGOUT
  SYNC
  CONFIG_CHANGE
  ADMIN_OPERATION
  ERROR
}

enum AuditResult {
  SUCCESS
  FAILURE
}

/// Registro append-only de operaciones sensibles del sistema. No tiene
/// relación (FK) con Bank/BankAccount a propósito: si la cuenta se borra
/// algún día, el rastro de auditoría debe sobrevivir intacto para
/// investigación de incidentes (por eso `entityId` es un String suelto,
/// no una FK con cascade).
model AuditLog {
  id           String      @id @default(uuid())
  action       AuditAction
  actor        String
  entityType   String      @map("entity_type")
  entityId     String?     @map("entity_id")
  result       AuditResult
  metadata     Json?
  errorMessage String?     @map("error_message")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

enum AlertType {
  ACCOUNT_NOT_SYNCING
  HIGH_ERROR_RATE
  ACCOUNT_ESCALATED
  SERVICE_DEGRADED
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

/// Igual que AuditLog: append-only y sin FK a propósito, para que la
/// alerta sobreviva como evidencia aunque la cuenta/banco se borre
/// después.
model AlertLog {
  id         String        @id @default(uuid())
  type       AlertType
  severity   AlertSeverity
  message    String
  entityType String        @map("entity_type")
  entityId   String?       @map("entity_id")
  metadata   Json?
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([type, entityType, entityId])
  @@index([createdAt])
  @@map("alert_logs")
}

model SyncLog {
  id              String     @id @default(uuid())
  accountId       String     @map("account_id")
  startedAt       DateTime   @default(now()) @map("started_at")
  finishedAt      DateTime?  @map("finished_at")
  status          SyncStatus @default(RUNNING)
  error           String?
  movementsFound  Int        @default(0) @map("movements_found")
  movementsNew    Int        @default(0) @map("movements_new")
  durationMs      Int?       @map("duration_ms")

  account BankAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, startedAt])
  @@map("sync_logs")
}

// ─────────────────────────────────────────────────────────────────────
// Portal de Comercios: autenticación, dispositivos de confianza y
// notificaciones. Vive en tablas propias, separadas de BankAccount/Bank
// (que siguen sin saber nada de "quién inició sesión"). `BankAccount.merchantId`
// SÍ tiene FK real a `Merchant.id` (ver el modelo BankAccount): es el
// dueño de la cuenta y el ancla del aislamiento multi-tenant — sin la
// constraint, un `merchant_id` arbitrario crearía cuentas inalcanzables.
// ─────────────────────────────────────────────────────────────────────

enum DocumentType {
  CC // Cédula de ciudadanía
  CE // Cédula de extranjería
  NIT
  PASAPORTE
}

enum MerchantStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

model Merchant {
  id                     String         @id @default(uuid())
  documentType           DocumentType   @map("document_type")
  documentNumber         String         @map("document_number")
  fullName               String         @map("full_name")
  email                  String         @unique
  phone                  String
  passwordHash           String         @map("password_hash")
  // Referencia OPACA al archivo (mismo patrón que PaymentSubmission.fileStorageRef),
  // cuyo contenido además viaja cifrado en disco — ver DocumentPhotoStoragePort.
  documentPhotoStorageRef String        @map("document_photo_storage_ref")
  status                 MerchantStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt        DateTime?      @map("email_verified_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  trustedDevices      TrustedDevice[]
  loginChallenges     LoginChallenge[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  bankAccounts        BankAccount[]

  // Un mismo documento de identidad no puede registrar dos cuentas.
  @@unique([documentType, documentNumber], name: "uniq_document_type_number")
  @@map("merchants")
}

/// Código de un solo uso para restablecer la contraseña del Portal.
/// Separado de LoginChallenge a propósito: son flujos distintos (aquel
/// prueba identidad para INICIAR sesión; este autoriza CAMBIAR la
/// contraseña) y mezclarlos permitiría, por error, usar un challenge de
/// login para resetear credenciales.
model PasswordResetToken {
  id         String    @id @default(uuid())
  merchantId String    @map("merchant_id")
  // sha256 del token de un solo uso (alta entropía, no hace falta bcrypt) —
  // nunca se guarda el token en texto plano.
  secretHash String    @map("secret_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId, createdAt])
  @@map("password_reset_tokens")
}

model TrustedDevice {
  id             String    @id @default(uuid())
  merchantId     String    @map("merchant_id")
  // sha256 de un id de dispositivo generado client-side + User-Agent —
  // nunca el User-Agent crudo ni nada que por sí solo identifique al
  // dispositivo fuera de este sistema.
  fingerprint    String
  label          String // ej. "Chrome en Windows — agregado el 12 oct"
  lastUsedAt     DateTime  @default(now()) @map("last_used_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  revokedAt      DateTime? @map("revoked_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, fingerprint], name: "uniq_merchant_fingerprint")
  @@map("trusted_devices")
}

enum LoginChallengeType {
  EMAIL_CODE
  DEVICE_APPROVAL
}

enum LoginChallengeStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

/// Representa UN intento de login pendiente de segundo factor. Un mismo
/// intento (mismo `attemptId`) puede tener dos challenges en paralelo —
/// EMAIL_CODE y DEVICE_APPROVAL — y basta con que CUALQUIERA de los dos
/// se apruebe para completar el login (ver AuthService.completeLogin).
model LoginChallenge {
  id                 String               @id @default(uuid())
  attemptId          String               @map("attempt_id")
  merchantId         String               @map("merchant_id")
  type               LoginChallengeType
  // sha256 del código de 6 dígitos (EMAIL_CODE) o de un token aleatorio
  // (DEVICE_APPROVAL) — nunca el valor en texto plano.
  // Solo aplica a EMAIL_CODE (hash del código de 6 dígitos); DEVICE_APPROVAL
  // no tiene secreto propio — se aprueba con la sesión YA autenticada del
  // otro dispositivo, no con un código, así que queda null.
  secretHash         String?              @map("secret_hash")
  // Fingerprint del dispositivo NUEVO que está intentando entrar —
  // el que queda marcado como de confianza si este challenge se aprueba.
  newDeviceFingerprint String              @map("new_device_fingerprint")
  newDeviceLabel     String               @map("new_device_label")
  status             LoginChallengeStatus @default(PENDING)
  expiresAt          DateTime             @map("expires_at")
  createdAt          DateTime             @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([attemptId])
  @@index([merchantId, status])
  @@map("login_challenges")
}

enum NotificationType {
  NEW_LOGIN
  BANK_ACCOUNT_ADDED
  BANK_ACCOUNT_REMOVED
}

/// Centro de notificaciones del comercio en el Portal — persiste lo
/// mismo que se le envía por correo, para que quede visible dentro de
/// la app aunque el correo se pierda o llegue a spam.
model Notification {
  id         String           @id @default(uuid())
  merchantId String           @map("merchant_id")
  type       NotificationType
  message    String
  metadata   Json?
  emailSentAt DateTime?       @map("email_sent_at")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId, createdAt])
  @@map("notifications")
}
