# Variables del stack Docker completo (docker-compose.yml de la raíz).
#
# Uso: copia este archivo a `.env` (mismo directorio) y complétalo.
#   Copy-Item .env.example .env
#
# Docker Compose carga `.env` automáticamente; los valores de acá se
# inyectan en los servicios. Si dejas vacías las tres variables marcadas
# como OBLIGATORIAS, `docker compose up` falla de inmediato con un
# mensaje claro (mejor que arrancar con un secreto débil).

# ── Obligatorias ────────────────────────────────────────
# Genera cada una con (PowerShell):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Cifra las credenciales bancarias (AES-256-GCM). 32 bytes en hex.
CREDENTIALS_ENCRYPTION_KEY=
# Protege la API interna del backend; es la MISMA clave que usa el panel
# admin server-side para hablar con el backend.
INTERNAL_API_KEY=
# Firma los JWT de sesión de los comercios en el portal.
AUTH_JWT_SECRET=

# ── Base de datos (Postgres del propio compose) ─────────
POSTGRES_USER=assu
POSTGRES_PASSWORD=assu
POSTGRES_DB=assu
REDIS_PASSWORD=

# ── Cifrado de credenciales ─────────────────────────────
# 'local' (default) usa CREDENTIALS_ENCRYPTION_KEY. 'aws-kms' delega en
# AWS KMS y requiere AWS_KMS_KEY_ID + credenciales de AWS.
ENCRYPTION_PROVIDER=local
AWS_KMS_REGION=us-east-1
AWS_KMS_KEY_ID=
# Solo durante una rotación de clave: la clave ANTERIOR.
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=

# ── URLs públicas (las que abren los navegadores) ───────
NEXT_PUBLIC_PORTAL_URL=http://localhost:3300
PORTAL_APP_URL=http://localhost:3300

# ── Scraping ────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_PROXY_SERVER=
PLAYWRIGHT_PROXY_USERNAME=
PLAYWRIGHT_PROXY_PASSWORD=
DEFAULT_SYNC_INTERVAL_SECONDS=60
RATE_LIMIT_MAX_PER_BANK_PER_MINUTE=20
RATE_LIMIT_MIN_SECONDS_BETWEEN_ACCOUNT_SYNCS=10

# ── Verificación de comprobantes ────────────────────────
# 'tesseract' activa OCR real (local, gratis); cualquier otro valor deja
# el placeholder que manda todo a revisión manual.
OCR_PROVIDER=null
# Bot de Telegram (opcional): token de @BotFather y la cuenta bancaria a
# la que se asocian los comprobantes que reciba.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BANK_ACCOUNT_ID=

# ── Alertas de monitoreo ────────────────────────────────
MONITORING_NOTIFIER=log
MONITORING_ALERT_EMAILS=
MONITORING_STALE_THRESHOLD_MINUTES=30
MONITORING_ERROR_RATE_WINDOW_MINUTES=15
MONITORING_ERROR_RATE_THRESHOLD=0.5
MONITORING_ERROR_RATE_MIN_SAMPLE=3
MONITORING_ALERT_COOLDOWN_MINUTES=60

# ── Correo del Portal de Comercios ──────────────────────
# 'console' (default) solo loguea; 'smtp' envía de verdad.
EMAIL_PROVIDER=console
SMTP_FROM=Assu <no-reply@assu.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Autenticación del Portal ────────────────────────────
AUTH_JWT_EXPIRES_IN=12h
AUTH_EMAIL_CODE_EXPIRY_MINUTES=10
AUTH_DEVICE_APPROVAL_EXPIRY_MINUTES=5
AUTH_PASSWORD_RESET_EXPIRY_MINUTES=30

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=info
EVENTS_STREAM_NAME=assu.movements
