# Configuración de pnpm para TODO el workspace.
#
# IMPORTANTE: pnpm solo lee el .npmrc de la RAÍZ del workspace al instalar.
# Antes esta configuración vivía dentro de assu-backend/.npmrc y
# assu-frontend/.npmrc, así que al ejecutar `pnpm install` desde la raíz se
# ignoraba y pnpm usaba el linker por defecto (aislado, con symlinks), que en
# Windows se queda colgado creando cientos de miles de enlaces.

# node-linker=hoisted: genera un node_modules plano (como npm), el layout más
# rápido y confiable en Windows.
node-linker=hoisted

# Necesario para que NestJS resuelva reflect-metadata y los @types/* como
# dependencias planas.
shamefully-hoist=true

# Comodidad de resolución de peers en un monorepo.
strict-peer-dependencies=false
auto-install-peers=true

# No re-verificar el hash de cada archivo del store en cada importación.
# En Windows (con Windows Defender activo) esa verificación es lo que hace
# que `pnpm install` parezca congelado durante la fase de "added".
verify-store-integrity=false

# Ejecutar los scripts de package.json con PowerShell en lugar de cmd.exe.
# Sin esto, `pnpm run <script>` lanza cmd.exe en Windows y la terminal cambia
# de PowerShell a cmd al arrancar los servidores.
script-shell=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
