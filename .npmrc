# NestJS depende de reflect-metadata y de que ciertos paquetes de tipos
# (ej. @types/*) queden accesibles como si fueran dependencias planas.
# pnpm es estricto por defecto (aislamiento de node_modules), así que se
# habilita hoisting para evitar errores de resolución en tiempo de build.
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true
